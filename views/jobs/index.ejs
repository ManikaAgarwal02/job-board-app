<!DOCTYPE html>
<html lang="en">
<head>
    <title>All Jobs</title>
</head>
<body>

    <h1>All Jobs</h1>

    <% jobs.forEach((job) => { %>
        <a href="/jobs/<%= job._id %>">
    View Details
</a>

        <div>

            <h2><%= job.title %></h2>

            <p>
                <strong>Company:</strong>
                <%= job.company %>
            </p>

            <p>
                <strong>Location:</strong>
                <%= job.location %>
            </p>

            <p>
                <strong>Salary:</strong>
                ₹ <%= job.salary %>
            </p>

            <p>
                <strong>Description:</strong>
                <%= job.description %>
            </p>

            <hr>

        </div>

    <% }) %>

</body>
</html>